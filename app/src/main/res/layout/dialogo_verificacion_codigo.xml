<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnRegresarVerif"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/selector_drawer_texto"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vincular Cuenta"
            android:textColor="@color/studios_cyan_titulo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="@color/studios_cyan_sombra"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15"/>

        <ImageButton
            android:id="@+id/btnCerrarVerif"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/gris_texto" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Se ha enviado un código de verificación a"
        android:textColor="@color/gris_texto"
        android:textSize="14sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvCorreoDestino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="correo@ejemplo.com"
        android:textColor="@color/studios_cyan_titulo"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa el código de 5 dígitos"
        android:textColor="@color/gris_texto"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCodigoVerificacion"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:inputType="number"
            android:maxLength="5"
            android:letterSpacing="1.5"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerificarCodigo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Verificar Código"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/studios_cyan_titulo"/>

</LinearLayout>