<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/studios_cyan_titulo"
            android:shadowColor="@color/studios_cyan_sombra"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notificaciones"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/studios_cyan_titulo"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/studios_cyan_titulo"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_notificacion"
                    app:tint="@color/studios_cyan_titulo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permiso del sistema"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstadoPermiso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verificando..."
                        android:textColor="@color/gris_texto"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrAjustesPermiso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activar"
                    android:textSize="12sp"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/studios_cyan_titulo"
                    app:strokeWidth="1dp"
                    android:textColor="@color/studios_cyan_titulo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/studios_cyan_titulo"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_notificacion_activa"
                        app:tint="@color/studios_cyan_titulo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notificación Fija Diaria"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alerta persistente con tus tareas pendientes"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifFija"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/studios_cyan_titulo"
                        app:trackTint="@color/fondo_item_seleccionado" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHoraNotifFija"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="0dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hora de la notificación"
                        android:textColor="@color/gris_texto"
                        android:textSize="13sp"
                        android:layout_marginStart="16dp" />

                    <!-- Botón selector de hora -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeleccionarHoraFija"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00 PM"
                        android:textSize="13sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/studios_cyan_titulo"
                        app:strokeWidth="1dp"
                        android:textColor="@color/studios_cyan_titulo"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/studios_cyan_titulo"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_alarma"
                        app:tint="@color/studios_cyan_titulo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recordatorios Aleatorios"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Menciona una tarea pendiente al azar"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRecordatorios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/studios_cyan_titulo"
                        app:trackTint="@color/fondo_item_seleccionado" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutFrecuenciaRecordatorio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frecuencia"
                        android:textColor="@color/gris_texto"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginStart="44dp" />

                    <!-- Chips de frecuencia -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFrecuencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="44dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip4h"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cada 4h"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            app:chipBackgroundColor="@color/fondo_item_seleccionado"
                            app:checkedIconTint="@color/studios_cyan_titulo"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip8h"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cada 8h"
                            android:textSize="12sp"
                            android:checked="true"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            app:chipBackgroundColor="@color/fondo_item_seleccionado"
                            app:checkedIconTint="@color/studios_cyan_titulo"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip12h"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cada 12h"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            app:chipBackgroundColor="@color/fondo_item_seleccionado"
                            app:checkedIconTint="@color/studios_cyan_titulo"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip24h"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cada 24h"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            app:chipBackgroundColor="@color/fondo_item_seleccionado"
                            app:checkedIconTint="@color/studios_cyan_titulo"
                            android:textColor="?attr/colorOnSurface" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apariencia"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/studios_cyan_titulo"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/studios_cyan_titulo"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/opcionTemaPorDefecto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_telefono"
                        app:tint="@color/studios_cyan_titulo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Predeterminado del sistema"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/radioTemaSistema"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:buttonTint="@color/studios_cyan_titulo" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="56dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/studios_cyan_titulo"
                    android:alpha="0.2" />

                <LinearLayout
                    android:id="@+id/opcionTemaClaro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_modo_claro"
                        app:tint="@color/studios_cyan_titulo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Tema Claro"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/radioTemaClaro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:buttonTint="@color/studios_cyan_titulo" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="56dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/studios_cyan_titulo"
                    android:alpha="0.2" />

                <LinearLayout
                    android:id="@+id/opcionTemaOscuro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_modo_oscuro"
                        app:tint="@color/studios_cyan_titulo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Tema Oscuro"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/radioTemaOscuro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:buttonTint="@color/studios_cyan_titulo" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acerca de"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/studios_cyan_titulo"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/studios_cyan_titulo"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/studios_cyan_titulo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Versión"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0.0"
                        android:textColor="@color/gris_texto"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>