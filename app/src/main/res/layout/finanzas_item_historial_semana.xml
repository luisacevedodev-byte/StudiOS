<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="2dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"> <RelativeLayout
            android:id="@+id/layoutCabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvRangoFechas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 Abr - 07 Abr"
                android:textColor="@color/studios_cyan_titulo"
                android:textSize="17sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/ivFlecha"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_expand_more_24"
                app:tint="?attr/colorOnSurfaceVariant" />
        </RelativeLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:columnCount="2"
                android:alignmentMode="alignBounds">

                <TextView
                    android:id="@+id/tvGastadoItem"
                    android:layout_columnWeight="1"
                    android:textSize="13sp"
                    android:text="Gasto: $0.00"
                    android:textColor="#FF5252" />

                <TextView
                    android:id="@+id/tvIngresoItem"
                    android:layout_columnWeight="1"
                    android:textSize="13sp"
                    android:text="Ingreso: $0.00"
                    android:textColor="#4CAF50" />

                <TextView
                    android:id="@+id/tvMetaItem"
                    android:layout_columnWeight="1"
                    android:textSize="13sp"
                    android:text="Presupuesto: $0.00"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvSobranteItem"
                    android:layout_columnWeight="1"
                    android:textSize="13sp"
                    android:text="Restante: $0.00"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </GridLayout>

            <LinearLayout
                android:id="@+id/layoutDetalleDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:id="@+id/contenedorDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>