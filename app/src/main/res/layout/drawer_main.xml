<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:layout_gravity="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="StudiOS"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/studios_cyan_titulo"
            android:shadowColor="@color/studios_cyan_sombra"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15" />

        <ImageView
            android:id="@+id/btnCloseDrawer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            app:tint="@color/selector_drawer_texto" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/nav_img_perfil"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_person_circle"
            app:tint="@color/selector_drawer_texto" />

        <TextView
            android:id="@+id/nav_header_perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mi perfil"
            android:textSize="16sp"
            android:textColor="@color/gris_texto" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Vincular cuenta"
            android:textSize="12sp"
            android:textColor="@color/studios_cyan_titulo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/studios_cyan"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/nav_dashboard_item"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@android:color/transparent"> <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_inicio" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicio"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tareas_item"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@android:color/transparent"> <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_box"
                app:tint="@color/gris_texto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tareas"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/gris_texto" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_finanzas_item"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_attach_money" app:tint="@color/gris_texto"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Finanzas" android:layout_marginStart="16dp" android:textColor="@color/gris_texto"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_notas_item"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_edit_note" app:tint="@color/gris_texto"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notas" android:layout_marginStart="16dp" android:textColor="@color/gris_texto"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


    <LinearLayout
        android:id="@+id/nav_ajustes_item"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings" app:tint="@color/gris_texto"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Configuración" android:layout_marginStart="16dp" android:textColor="@color/gris_texto"/>
    </LinearLayout>

</LinearLayout>